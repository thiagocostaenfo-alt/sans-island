<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Sans Island</string>
    <string name="tagline">A ilha dinâmica do iPhone, em volta da câmera do seu Galaxy.</string>
    <string name="accessibility_description">Mostra a ilha dinâmica em volta da câmera frontal, por cima dos outros apps. O Sans Island não lê nem guarda o conteúdo das telas: usa este acesso só para desenhar a ilha, saber qual app está aberto e esconder a ilha quando a cortina de notificações é aberta.</string>

    <string name="section_permissions">Permissões</string>
    <string name="perm_accessibility">Acessibilidade</string>
    <string name="perm_accessibility_desc">Desenha a ilha por cima de tudo, inclusive da barra de status. Em Acessibilidade → Apps instalados → Sans Island, ative o serviço.</string>
    <string name="perm_notifications">Acesso a notificações</string>
    <string name="perm_notifications_desc">Mostra música, chamadas, timers, entregas e mensagens na ilha. Nada sai do celular.</string>
    <string name="restricted_title">Opção apagada ou bloqueada?</string>
    <string name="restricted_desc">Apps instalados por APK vêm com as configurações restritas. Abra as informações do app, toque nos três pontinhos (⋮) no canto superior e em "Permitir configurações restritas". Depois volte e ative as duas permissões acima.</string>
    <string name="open_app_info">Abrir informações do app</string>
