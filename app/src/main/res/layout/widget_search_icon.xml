<?xml version="1.0" encoding="utf-8"?>
<!-- small search pill like the iPhone home screen "Search" button, centered in the widget cell -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/widget_search"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_gravity="center"
        android:background="@drawable/widget_pill_icon"
        android:contentDescription="@string/widget_search_hint"
        android:gravity="center_vertical"
        android:minWidth="112dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/widget_g"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_search"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:maxLines="1"
            android:text="@string/widget_search_hint"
            android:textColor="#E6E8EC"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
