<?xml version="1.0" encoding="utf-8"?>
<!-- the bar has a fixed height (like the stock Google bar) and is centered in the widget cell -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="49dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_bar_smoky"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="6dp">

            <LinearLayout
                android:id="@+id/widget_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="@string/widget_search_hint"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_g"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_search"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:maxLines="1"
                    android:text="@string/widget_search_hint"
                    android:textColor="#CDD0D6"
                    android:textSize="16sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_mic"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:contentDescription="@string/widget_voice"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mic" />

            <ImageView
                android:id="@+id/widget_lens"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:contentDescription="@string/widget_lens"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_lens" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
