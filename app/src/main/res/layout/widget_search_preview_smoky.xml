<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_bg_smoky"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingEnd="18dp">
    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_search" />
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingStart="12dp"
        android:text="@string/widget_search_hint"
        android:textColor="#CDD0D6"
        android:textSize="16sp" />
    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_marginEnd="20dp" android:src="@drawable/ic_mic" />
    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_lens" />
</LinearLayout>
